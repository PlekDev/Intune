# ESP32-S3 a 240 MHz, sin Bluetooth ni Wi-Fi (el enlace es todo por UART)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_BT_ENABLED=n
# DevKitC-1 N8: 8 MB de flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Modelo + TFLite Micro no caben en la partición de 1 MB por defecto
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
